17:51:38 out   function Greeting(){
17:51:38 out   const {t,session,lang}=usePreferences();
17:51:38 out   const profile=useResource<{display_name?:string}>(session.status==='signedIn'?'/api/backend/profile':null);
17:51:38 out   const [hour,setHour]=React.useState<number|null>(null);React.useEffect(()=>setHour(new Date().getHours()),[]);
17:51:38 out   const name=profile.status==='ready'?profile.data.display_name?.trim():'';
17:51:38 out   const hello=session.status==='signedIn'?`${hour!==null&&hour>=18?t('home.evening'):t('home.morning')}${name?`, ${name}`:''}`:t('home.welcome');
17:51:38 out   return <div lang={lang}><h1 className="text-[1.75rem] font-bold leading-tight sm:text-[2.125rem]">{hello}</h1><p className="mt-1.5 text-[0.96875rem] text-muted">{t('home.lead')}</p></div>
